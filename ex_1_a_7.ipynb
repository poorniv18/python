        "#salary calculation\n",
        "basic_salary=float(input(\"Enter basic salary:\"))\n",
        "hra=basic_salary*0.20;\n",
        "da=basic_salary*0.10;\n",
        "total_salary=basic_salary+hra+da;\n",
        "print(\"HRA: \",hra)\n",
        "print(\"DA: \",da)\n",
        "print(\"Total_Salary: \",total_salary)"
      ]
